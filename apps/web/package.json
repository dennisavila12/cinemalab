{
  "name": "@cinemalab/web",
  "version": "2.0.0",
  "private": true,
  "description": "Interfaz de CinemaLab (React + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "build:demo": "tsc --noEmit -p . && vite build --mode demo"
  },
  "dependencies": {
    "@cinemalab/contratos": "workspace:*",
    "@fontsource/kalam": "^5.3.0",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.0"
  }
}
